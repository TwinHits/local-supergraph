{
  "compilerOptions": {
    "target": "ES2020",
    "strict": true,
    // vitest ships .d.ts files referencing peers we do not install
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    // fixtures/ import each other with .ts extensions, which is how Node runs them
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "test",
    "fixtures",
    "vite.config.ts",
    "vite.electron.config.ts"
  ]
}
