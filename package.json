{
  "name": "local-supergraph",
  "version": "1.0.0",
  "private": true,
  "main": "dist-electron/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "start": "npm run build && electron .",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "fix": "npm run format && npm run lint",
    "fixtures": "node fixtures/start.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "vite build && vite build --config vite.electron.config.ts --mode main && vite build --config vite.electron.config.ts --mode preload",
    "typecheck": "tsc --noEmit",
    "check": "prettier --check . && eslint . && npm run typecheck",
    "update": "npm update && npm audit",
    "clean": "rimraf dist dist-electron coverage vite.config.js vite.config.d.ts vite.electron.config.js vite.electron.config.d.ts",
    "prepare": "husky",
    "reset": "npm run clean && rimraf node_modules package-lock.json .husky/_ && npm install"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@apollo/server": "^5.5.1",
    "@apollo/subgraph": "^2.15.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "electron": "^44.2.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "graphql": "^16.14.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "sass": "^1.104.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
