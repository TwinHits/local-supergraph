# Copy to .env and fill in. .env is gitignored; this file is not.
# Nothing here is committed with a real value — the repo stays agnostic.

# Personal API key from studio.apollographql.com. Starts with "service:" or "user:".
APOLLO_KEY=

# The graph and variant to run, as name@variant.
APOLLO_GRAPH_REF=

# Comma-separated variants offered in the header dropdown. Yours to edit.
# Example: SUPERGRAPH_VARIANTS=current,staging
SUPERGRAPH_VARIANTS=

# Add any credentials your local subgraphs need below.
